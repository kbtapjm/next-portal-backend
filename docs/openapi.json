{
  "openapi": "3.1.0",
  "info": {
    "title": "Next Portal Admin API",
    "version": "0.1.0",
    "description": "페이지는 0부터 시작합니다. Access JWT는 Redis 및 계정 상태를 매 요청 검증합니다. 사용자 시스템의 로그인·회원가입은 후속 범위입니다."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Spring 관리자 서버"
    },
    {
      "url": "http://localhost:3000",
      "description": "Next.js 관리자 rewrite"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/admin/auth/login": {
      "post": {
        "operationId": "adminLogin",
        "summary": "관리자 로그인",
        "description": "활성 ADMIN 계정만 허용합니다. Access JWT를 응답하고 Refresh 토큰을 HttpOnly 쿠키로 설정합니다.",
        "security": [],
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "http://localhost:3000",
            "description": "ALLOWED_ORIGINS의 정확한 출처와 일치해야 합니다."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "portal_admin_refresh=<opaque-token>; HttpOnly; SameSite=Strict; Path=/api/admin/auth; Max-Age=604800. HTTPS에서는 Secure 적용."
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            }
          },
          "400": {
            "description": "요청 실패. 인증 필터의 401/403은 응답 본문이 없을 수 있습니다.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "인증 실패/만료/폐기된 세션"
          },
          "403": {
            "description": "관리자 권한 또는 허용된 Origin 없음"
          },
          "409": {
            "description": "요청 실패. 인증 필터의 401/403은 응답 본문이 없을 수 있습니다.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/auth/refresh": {
      "post": {
        "operationId": "adminRefresh",
        "summary": "토큰 갱신",
        "description": "쿠키의 Refresh 토큰은 단 한 번 사용 가능하며 원자적으로 교체합니다. 이전 Access JWT도 거부됩니다. 계정 역할/상태 변경 시 재로그인해야 합니다.",
        "security": [
          {
            "refreshCookie": []
          }
        ],
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "http://localhost:3000",
            "description": "ALLOWED_ORIGINS의 정확한 출처와 일치해야 합니다."
          }
        ],
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "portal_admin_refresh=<opaque-token>; HttpOnly; SameSite=Strict; Path=/api/admin/auth; Max-Age=604800. HTTPS에서는 Secure 적용."
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            }
          },
          "400": {
            "description": "요청 실패. 인증 필터의 401/403은 응답 본문이 없을 수 있습니다.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "인증 실패/만료/폐기된 세션"
          },
          "403": {
            "description": "관리자 권한 또는 허용된 Origin 없음"
          },
          "409": {
            "description": "요청 실패. 인증 필터의 401/403은 응답 본문이 없을 수 있습니다.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/auth/logout": {
      "post": {
        "operationId": "adminLogout",
        "summary": "현재 세션 폐기",
        "responses": {
          "204": {
            "description": "Redis 세션 삭제 및 Refresh 쿠키 만료"
          },
          "401": {
            "description": "유효한 Access 토큰 필요"
          }
        }
      }
    },
    "/api/admin/auth/me": {
      "get": {
        "operationId": "adminMe",
        "summary": "현재 관리자 조회",
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Member"
                }
              }
            }
          },
          "400": {
            "description": "요청 실패. 인증 필터의 401/403은 응답 본문이 없을 수 있습니다.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "인증 실패/만료/폐기된 세션"
          },
          "403": {
            "description": "관리자 권한 또는 허용된 Origin 없음"
          },
          "409": {
            "description": "요청 실패. 인증 필터의 401/403은 응답 본문이 없을 수 있습니다.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/users": {
      "get": {
        "operationId": "searchUsers",
        "summary": "사용자 목록 검색",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 100
            },
            "description": "이름·이메일의 대소문자 무관 부분 검색"
          },
          {
            "name": "role",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/Role"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/MemberStatus"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberPage"
                }
              }
            }
          },
          "400": {
            "description": "요청 실패. 인증 필터의 401/403은 응답 본문이 없을 수 있습니다.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "인증 실패/만료/폐기된 세션"
          },
          "403": {
            "description": "관리자 권한 또는 허용된 Origin 없음"
          },
          "409": {
            "description": "요청 실패. 인증 필터의 401/403은 응답 본문이 없을 수 있습니다.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createUser",
        "summary": "사용자/관리자 생성",
        "description": "이메일은 공백 제거 후 소문자로 저장합니다. 비밀번호는 12자 이상, UTF-8 72바이트 이하입니다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUser"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Member"
                }
              }
            }
          },
          "400": {
            "description": "요청 실패. 인증 필터의 401/403은 응답 본문이 없을 수 있습니다.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "인증 실패/만료/폐기된 세션"
          },
          "403": {
            "description": "관리자 권한 또는 허용된 Origin 없음"
          },
          "409": {
            "description": "요청 실패. 인증 필터의 401/403은 응답 본문이 없을 수 있습니다.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/users/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          }
        }
      ],
      "get": {
        "operationId": "getUser",
        "summary": "사용자 조회",
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Member"
                }
              }
            }
          },
          "400": {
            "description": "요청 실패. 인증 필터의 401/403은 응답 본문이 없을 수 있습니다.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "인증 실패/만료/폐기된 세션"
          },
          "403": {
            "description": "관리자 권한 또는 허용된 Origin 없음"
          },
          "404": {
            "description": "요청 실패. 인증 필터의 401/403은 응답 본문이 없을 수 있습니다.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "요청 실패. 인증 필터의 401/403은 응답 본문이 없을 수 있습니다.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "updateUser",
        "summary": "사용자 이름·역할·상태 변경",
        "description": "자신의 관리자 권한 해제·비활성화는 409로 거부합니다. 역할/상태 변경 시 모든 기존 토큰의 인증 버전이 무효화됩니다. 삭제 대신 비활성화합니다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUser"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Member"
                }
              }
            }
          },
          "400": {
            "description": "요청 실패. 인증 필터의 401/403은 응답 본문이 없을 수 있습니다.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "인증 실패/만료/폐기된 세션"
          },
          "403": {
            "description": "관리자 권한 또는 허용된 Origin 없음"
          },
          "404": {
            "description": "요청 실패. 인증 필터의 401/403은 응답 본문이 없을 수 있습니다.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "요청 실패. 인증 필터의 401/403은 응답 본문이 없을 수 있습니다.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "refreshCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "portal_admin_refresh"
      }
    },
    "schemas": {
      "Role": {
        "type": "string",
        "enum": [
          "ADMIN",
          "USER"
        ]
      },
      "MemberStatus": {
        "type": "string",
        "enum": [
          "ACTIVE",
          "DISABLED"
        ]
      },
      "Login": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 72,
            "writeOnly": true
          }
        }
      },
      "Token": {
        "type": "object",
        "required": [
          "accessToken",
          "tokenType",
          "expiresIn"
        ],
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string",
            "const": "Bearer"
          },
          "expiresIn": {
            "type": "integer",
            "description": "유효기간(초)",
            "example": 900
          }
        }
      },
      "Member": {
        "type": "object",
        "required": [
          "id",
          "email",
          "name",
          "role",
          "status",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "status": {
            "$ref": "#/components/schemas/MemberStatus"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateUser": {
        "type": "object",
        "required": [
          "email",
          "name",
          "password",
          "role"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 72,
            "writeOnly": true,
            "description": "UTF-8 인코딩 길이도 72바이트 이하여야 합니다."
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        }
      },
      "UpdateUser": {
        "type": "object",
        "required": [
          "name",
          "role",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "status": {
            "$ref": "#/components/schemas/MemberStatus"
          }
        }
      },
      "MemberPage": {
        "type": "object",
        "required": [
          "content",
          "page",
          "size",
          "totalElements",
          "totalPages"
        ],
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Member"
            }
          },
          "page": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          },
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer"
          }
        }
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
