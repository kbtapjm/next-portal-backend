{
  "openapi": "3.1.0",
  "info": {
    "title": "Next Portal 관리자 API",
    "description": "로컬 개발용 API 문서입니다. 로그인 후 받은 accessToken을 Authorize의 bearerAuth에 입력하세요. Bearer 접두어 없이 토큰 값만 입력합니다. Refresh는 로그인 시 저장된 HttpOnly 쿠키를 자동으로 사용합니다. 토큰 갱신 후에는 새 accessToken으로 Authorize를 다시 설정하세요. 페이지 번호는 0부터 시작합니다.",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "현재 실행 중인 서버"
    }
  ],
  "tags": [
    {
      "name": "03. 역할·권한 관리",
      "description": "역할에 세부 권한을 묶고 사용자에게 여러 역할을 부여합니다. 기본 접근에는 admin:access가 필요합니다."
    },
    {
      "name": "02. 사용자 관리",
      "description": "조회 user:read, 생성·수정 user:write. 역할 부여와 권한 관리자 수정에는 role:manage도 필요합니다."
    },
    {
      "name": "01. 관리자 인증",
      "description": "관리자 로그인, 내 정보, 토큰 갱신과 로그아웃"
    }
  ],
  "paths": {
    "/api/admin/users/{id}": {
      "get": {
        "tags": [
          "02. 사용자 관리"
        ],
        "summary": "사용자 조회",
        "description": "user:read 필요.",
        "operationId": "getUser",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "exclusiveMinimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "사용자 정보",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberView"
                }
              }
            }
          },
          "404": {
            "description": "사용자를 찾을 수 없음",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "400": {
            "description": "입력값 검증 실패",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "401": {
            "description": "유효한 Access JWT 필요"
          },
          "403": {
            "description": "admin:access 또는 해당 작업의 세부 권한 없음"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "put": {
        "tags": [
          "02. 사용자 관리"
        ],
        "summary": "사용자 정보 수정",
        "description": "user:write 필요. 역할 변경 또는 role:manage 보유 계정 수정에는 role:manage도 필요합니다. 본인 역할 변경·비활성화, 마지막 활성 ADMIN 해제는 거부됩니다. 역할·상태 변경 시 기존 Access·Refresh가 무효화됩니다.",
        "operationId": "updateUser",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "exclusiveMinimum": 0
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUser"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "수정된 사용자 정보",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberView"
                }
              }
            }
          },
          "404": {
            "description": "사용자를 찾을 수 없음",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409": {
            "description": "본인 권한 해제·비활성화 또는 동시 수정 충돌",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "400": {
            "description": "입력값 검증 실패",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "401": {
            "description": "유효한 Access JWT 필요"
          },
          "403": {
            "description": "admin:access 또는 해당 작업의 세부 권한 없음"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/admin/users/{id}/roles": {
      "put": {
        "tags": [
          "03. 역할·권한 관리"
        ],
        "summary": "사용자 역할 전체 교체",
        "description": "role:manage 필요. 역할 변경 시 해당 사용자의 기존 Access·Refresh가 무효화됩니다. 본인 역할 변경, 빈 역할 목록, 마지막 활성 ADMIN 해제는 거부합니다.",
        "operationId": "assignUserRoles",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "exclusiveMinimum": 0
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssignRoles"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "입력값 또는 역할·권한 코드 오류",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "401": {
            "description": "JWT 또는 세션 만료. 권한 변경 후에는 다시 로그인해야 합니다."
          },
          "403": {
            "description": "필요한 세부 권한 없음"
          },
          "404": {
            "description": "역할 또는 사용자 없음",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409": {
            "description": "중복 코드, 시스템 역할 수정, 부여 중인 역할 삭제, 본인 역할 변경 또는 마지막 ADMIN 해제",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "200": {
            "description": "역할이 변경된 사용자",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberView"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
