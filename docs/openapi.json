    "/api/admin/users": {
      "get": {
        "tags": [
          "02. 사용자 관리"
        ],
        "summary": "사용자 목록 검색",
        "description": "user:read 필요. 이름·이메일 부분 검색, 역할·상태 필터를 지원합니다. roleCode는 실제 역할 코드, role은 호환용 관리자 접근 여부 분류입니다. 최신 등록순, 페이지 번호는 0부터 시작합니다.",
        "operationId": "searchUsers",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "description": "이름 또는 이메일 검색어",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 100,
              "minLength": 0
            },
            "example": "홍길동"
          },
          {
            "name": "role",
            "in": "query",
            "required": false,
            "deprecated": true,
            "schema": {
              "type": "string",
              "enum": [
                "ADMIN",
                "USER"
              ]
            }
          },
          {
            "name": "roleCode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "[A-Z][A-Z0-9_]{0,49}"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "ACTIVE",
                "DISABLED"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0,
              "minimum": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20,
              "maximum": 100,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "400": {
            "description": "입력값 검증 실패",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "401": {
            "description": "유효한 Access JWT 필요"
          },
          "403": {
            "description": "admin:access 또는 해당 작업의 세부 권한 없음"
          },
          "200": {
            "description": "사용자 검색 결과",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberPage"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "tags": [
          "02. 사용자 관리"
        ],
        "summary": "사용자 등록",
        "description": "user:write 필요. roles 생략 시 USER. USER 이외 역할 부여에는 role:manage도 필요합니다. 이메일은 소문자 정규화, 비밀번호는 12자 이상 UTF-8 72바이트 이하입니다.",
        "operationId": "createUser",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUser"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "사용자 생성 완료",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberView"
                }
              }
            }
          },
          "409": {
            "description": "이미 등록된 이메일",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "400": {
            "description": "입력값 검증 실패",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "401": {
            "description": "유효한 Access JWT 필요"
          },
          "403": {
            "description": "admin:access 또는 해당 작업의 세부 권한 없음"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
