              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "401": {
            "description": "JWT 또는 세션 만료. 권한 변경 후에는 다시 로그인해야 합니다."
          },
          "403": {
            "description": "필요한 세부 권한 없음"
          },
          "404": {
            "description": "역할 또는 사용자 없음",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409": {
            "description": "중복 코드, 시스템 역할 수정, 부여 중인 역할 삭제, 본인 역할 변경 또는 마지막 ADMIN 해제",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "201": {
            "description": "역할 생성 완료",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoleView"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/admin/auth/refresh": {
      "post": {
        "tags": [
          "01. 관리자 인증"
        ],
        "summary": "토큰 갱신",
        "description": "로그인으로 저장된 HttpOnly Refresh 쿠키를 자동 전송합니다. 직접 쿠키 값을 입력할 필요는 없습니다. 쿠키는 한 번만 사용 가능하며 이전 Access JWT도 거부됩니다. 응답의 새 accessToken으로 Authorize를 다시 설정하세요.",
        "operationId": "adminRefresh",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "description": "브라우저가 자동 설정하는 허용 출처",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "http://localhost:8080"
          }
        ],
        "responses": {
          "400": {
            "description": "입력값 검증 실패",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "401": {
            "description": "인증 정보가 올바르지 않거나 세션이 만료·폐기됨. 보안 필터 응답은 본문이 없을 수 있습니다."
          },
          "403": {
            "description": "허용되지 않은 Origin 또는 관리자 권한 없음"
          },
          "200": {
            "description": "Access JWT 재발급 및 Refresh 쿠키 회전",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            }
          }
        },
        "security": [
          {
            "refreshCookie": []
          }
        ]
      }
    },
    "/api/admin/auth/logout": {
      "post": {
        "tags": [
          "01. 관리자 인증"
        ],
        "summary": "로그아웃",
        "description": "현재 Redis 세션을 삭제하고 Refresh 쿠키를 만료시킵니다.",
        "operationId": "adminLogout",
        "responses": {
          "400": {
            "description": "입력값 검증 실패",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "401": {
            "description": "인증 정보가 올바르지 않거나 세션이 만료·폐기됨. 보안 필터 응답은 본문이 없을 수 있습니다."
          },
          "403": {
            "description": "허용되지 않은 Origin 또는 관리자 권한 없음"
          },
          "204": {
            "description": "세션 폐기 완료"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/admin/auth/login": {
      "post": {
        "tags": [
          "01. 관리자 인증"
        ],
        "summary": "관리자 로그인",
        "description": "활성 계정 중 admin:access 권한 보유 계정만 로그인할 수 있습니다. Origin은 허용 출처와 일치해야 하며 브라우저가 실제 출처로 설정합니다. Swagger에서는 현재 서버 출처를 사용하세요. Refresh 쿠키가 자동 저장되며 응답의 accessToken으로 Authorize를 설정합니다.",
        "operationId": "adminLogin",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "description": "허용된 출처. 브라우저에서는 실제 Origin이 자동 적용됩니다.",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "http://localhost:8080"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminLogin"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "입력값 검증 실패",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "401": {
            "description": "인증 정보가 올바르지 않거나 세션이 만료·폐기됨. 보안 필터 응답은 본문이 없을 수 있습니다."
          },
          "403": {
            "description": "허용되지 않은 Origin 또는 관리자 권한 없음"
          },
          "200": {
            "description": "Access JWT 발급 및 Refresh 쿠키 저장",
            "headers": {
              "Cache-Control": {
                "style": "simple",
                "schema": {
                  "type": "string",
                  "example": "no-store"
                }
              },
              "Set-Cookie": {
                "description": "portal_admin_refresh 쿠키. HttpOnly, SameSite=Strict, Path=/api/admin/auth",
                "style": "simple",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/permissions": {
      "get": {
        "tags": [
          "03. 역할·권한 관리"
        ],
        "summary": "권한 카탈로그 조회",
        "description": "role:read 필요. 권한 코드는 실제 API 정책과 함께 마이그레이션으로 관리합니다.",
        "operationId": "listPermissions",
        "responses": {
          "400": {
            "description": "입력값 또는 역할·권한 코드 오류",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "401": {
            "description": "JWT 또는 세션 만료. 권한 변경 후에는 다시 로그인해야 합니다."
          },
          "403": {
            "description": "필요한 세부 권한 없음"
          },
          "404": {
            "description": "역할 또는 사용자 없음",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409": {
            "description": "중복 코드, 시스템 역할 수정, 부여 중인 역할 삭제, 본인 역할 변경 또는 마지막 ADMIN 해제",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "200": {
            "description": "권한 목록",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PermissionView"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/admin/auth/me": {
      "get": {
        "tags": [
          "01. 관리자 인증"
        ],
        "summary": "현재 관리자 및 권한 조회",
        "description": "roles는 부여된 역할, permissions는 합산된 세부 권한입니다. user:read 없이 자신의 정보만 조회할 수 있습니다.",
        "operationId": "adminMe",
        "responses": {
          "400": {
            "description": "입력값 검증 실패",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "401": {
            "description": "인증 정보가 올바르지 않거나 세션이 만료·폐기됨. 보안 필터 응답은 본문이 없을 수 있습니다."
          },
          "403": {
            "description": "허용되지 않은 Origin 또는 관리자 권한 없음"
          },
          "200": {
            "description": "현재 관리자 정보",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberView"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "UpdateUser": {
        "type": "object",
        "description": "사용자 이름·역할·상태 수정",
        "example": {
          "name": "홍길동",
          "status": "ACTIVE",
          "roles": [
            "USER_VIEWER"
          ]
        },
        "properties": {
          "name": {
            "type": "string",
            "example": "홍길동",
            "maxLength": 100,
            "minLength": 0
          },
          "role": {
            "type": "string",
            "deprecated": true,
            "description": "호환용 ADMIN/USER 분류. 현재 분류와 같으면 기존 역할 유지. roles와 동시 지정 불가.",
            "enum": [
              "ADMIN",
              "USER"
            ],
            "example": "USER"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "DISABLED"
            ],
            "example": "ACTIVE"
          },
          "roles": {
            "type": "array",
            "description": "역할 전체 교체. 생략 시 유지. 변경에는 role:manage가 필요합니다.",
            "example": [
              "USER_VIEWER"
            ],
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "[A-Z][A-Z0-9_]{0,49}"
            },
            "maxItems": 20,
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "name",
          "status"
        ]
      },
      "MemberView": {
        "type": "object",
        "description": "비밀번호를 포함하지 않는 사용자 정보",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "name": {
            "type": "string",
            "example": "홍길동"
          },
          "role": {
            "type": "string",
            "deprecated": true,
            "description": "호환용 분류. admin:access 보유 시 ADMIN, 그 외 USER. 실제 역할은 roles를 사용하세요.",
            "enum": [
              "ADMIN",
              "USER"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "DISABLED"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ProblemDetail": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri"
          },
          "properties": {
            "type": "object",
            "additionalProperties": {}
          }
        }
      },
      "AssignRoles": {
        "type": "object",
        "description": "사용자의 역할 전체 교체. 빈 역할 목록과 본인 역할 변경은 허용하지 않습니다.",
        "properties": {
          "roles": {
            "type": "array",
            "example": [
              "USER_VIEWER"
            ],
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "[A-Z][A-Z0-9_]{0,49}"
            },
            "maxItems": 20,
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "roles"
        ]
      },
      "UpdateRole": {
        "type": "object",
        "description": "이름과 권한 전체 교체. 권한이 달라지면 부여된 모든 계정의 기존 Access·Refresh가 무효화됩니다.",
        "properties": {
          "name": {
            "type": "string",
            "example": "감사 담당자",
            "maxLength": 100,
            "minLength": 0
          },
          "permissions": {
            "type": "array",
            "example": [
              "admin:access",
              "user:read"
            ],
            "items": {
              "type": "string",
              "maxLength": 80,
              "minLength": 0
            },
            "maxItems": 100,
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "name",
          "permissions"
        ]
      },
      "RoleView": {
        "type": "object",
        "description": "역할과 세부 권한. ADMIN·USER 시스템 역할은 변경·삭제할 수 없습니다.",
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "system": {
            "type": "boolean"
          },
          "permissionRevision": {
            "type": "integer",
            "format": "int64"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CreateUser": {
        "type": "object",
        "description": "사용자 등록 요청",
        "example": {
          "email": "user@example.com",
          "name": "홍길동",
          "password": "example-password-123!",
          "roles": [
            "USER"
          ]
        },
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "로그인 이메일",
            "example": "user@example.com",
            "maxLength": 254,
            "minLength": 0
          },
          "name": {
            "type": "string",
            "description": "사용자 이름",
            "example": "홍길동",
            "maxLength": 100,
            "minLength": 0
          },
          "password": {
            "type": "string",
            "format": "password",
            "description": "12자 이상, UTF-8 기준 72바이트 이하",
            "maxLength": 72,
            "minLength": 12,
            "writeOnly": true
          },
          "role": {
            "type": "string",
            "deprecated": true,
            "description": "기존 클라이언트 호환용. roles와 동시 지정할 수 없습니다.",
            "enum": [
              "ADMIN",
              "USER"
            ],
            "example": "USER"
          },
          "roles": {
            "type": "array",
            "description": "부여할 역할 코드. 미지정 시 USER. role과 동시 지정할 수 없습니다.",
            "example": [
              "USER"
            ],
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "[A-Z][A-Z0-9_]{0,49}"
            },
            "maxItems": 20,
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "email",
          "name",
          "password"
        ]
      },
      "CreateRole": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "AUDITOR",
            "minLength": 1,
            "pattern": "[A-Z][A-Z0-9_]{0,49}"
          },
          "name": {
            "type": "string",
            "example": "감사 담당자",
            "maxLength": 100,
            "minLength": 0
          },
          "permissions": {
            "type": "array",
            "example": [
              "admin:access",
              "user:read"
            ],
            "items": {
              "type": "string",
              "maxLength": 80,
              "minLength": 0
            },
            "maxItems": 100,
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "code",
          "name",
          "permissions"
        ]
      },
      "Token": {
        "type": "object",
        "description": "Access JWT와 유효기간. Refresh 토큰은 HttpOnly 쿠키로 전달됩니다.",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Authorize에 입력할 Access JWT"
          },
          "tokenType": {
            "type": "string",
            "example": "Bearer"
          },
          "expiresIn": {
            "type": "integer",
            "format": "int64",
            "description": "유효기간(초)",
            "example": 900
          }
        }
      },
      "AdminLogin": {
        "type": "object",
        "description": "관리자 로그인 요청",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "관리자 이메일",
            "example": "admin@portal.local",
            "maxLength": 254,
            "minLength": 0
          },
          "password": {
            "type": "string",
            "format": "password",
            "description": "등록된 관리자 비밀번호",
            "maxLength": 72,
            "minLength": 0,
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "MemberPage": {
        "type": "object",
        "description": "사용자 검색 결과. page는 0부터 시작합니다.",
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemberView"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "size": {
            "type": "integer",
            "format": "int32"
          },
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "PermissionView": {
        "type": "object",
        "description": "API에서 검사하는 고정 권한 카탈로그. 권한 추가는 코드와 DB 마이그레이션으로 수행합니다.",
        "properties": {
          "code": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "description": "로그인 응답의 accessToken. Bearer 접두어 없이 입력하세요.",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "refreshCookie": {
        "type": "apiKey",
        "description": "로그인 응답에서 브라우저에 자동 저장되는 HttpOnly 쿠키입니다. 직접 입력하지 않아도 됩니다.",
        "name": "portal_admin_refresh",
        "in": "cookie"
      }
    }
  }
}
